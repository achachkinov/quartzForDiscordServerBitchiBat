filters:
  and:
    - file.tags.contains("MOC")
views:
  - type: table
    name: inBox
    filters:
      and:
        - thought_status == "inBox"
    order:
      - file.name
      - created_dt
      - file.mtime
    sort:
      - property: file.ctime
        direction: DESC
    cardSize: 240
    imageAspectRatio: 0.85
    rowHeight: medium
    columnSize:
      file.name: 1137
      note.created_dt: 552
  - type: table
    name: fresh
    filters:
      and:
        - thought_status == "fresh"
    order:
      - file.name
      - created_dt
      - file.mtime
    sort:
      - property: created_dt
        direction: DESC
      - property: file.ctime
        direction: DESC
    cardSize: 240
    imageAspectRatio: 0.85
    rowHeight: medium
    columnSize:
      file.name: 1137
      note.created_dt: 552
  - type: table
    name: handling
    filters:
      or:
        - thought_status.contains("toLink")
        - thought_status.contains("handling")
    order:
      - file.name
      - created_dt
      - file.mtime
    sort:
      - property: file.ctime
        direction: DESC
    cardSize: 240
    imageAspectRatio: 0.85
    rowHeight: medium
    columnSize:
      file.name: 1137
      note.created_dt: 552
  - type: table
    name: mature
    filters:
      or:
        - thought_status.contains("archive")
        - thought_status.contains("mature")
    order:
      - file.name
      - created_dt
      - file.mtime
    sort:
      - property: file.ctime
        direction: DESC
    cardSize: 240
    imageAspectRatio: 0.85
    rowHeight: medium
    columnSize:
      file.name: 1137
      note.created_dt: 552
  - type: table
    name: freezed
    filters:
      and:
        - thought_status == "freezed"
    order:
      - file.name
      - created_dt
      - file.mtime
    sort:
      - property: file.ctime
        direction: DESC
    cardSize: 240
    imageAspectRatio: 0.85
    rowHeight: medium
    columnSize:
      file.name: 1137
      note.created_dt: 552
