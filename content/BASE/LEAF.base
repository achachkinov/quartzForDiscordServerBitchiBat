filters:
  and:
    - file.tags.contains("LEAF")
views:
  - type: table
    name: inBox
    filters:
      and:
        - thought_status == "inBox"
    order:
      - file.name
      - created_dt
      - file.mtime
    sort:
      - property: file.mtime
        direction: ASC
      - property: file.ctime
        direction: DESC
    cardSize: 240
    imageAspectRatio: 0.85
    rowHeight: medium
    columnSize:
      file.name: 331
      note.created_dt: 175
  - type: table
    name: fresh
    filters:
      and:
        - thought_status == "fresh"
    order:
      - file.name
      - created_dt
      - file.mtime
    sort:
      - property: created_dt
        direction: DESC
      - property: file.ctime
        direction: DESC
    cardSize: 240
    imageAspectRatio: 0.85
    rowHeight: medium
    columnSize:
      file.name: 265
      note.created_dt: 155
  - type: table
    name: handling
    filters:
      or:
        - thought_status.contains("toLink")
        - thought_status.contains("handling")
    order:
      - file.name
      - created_dt
      - file.mtime
    sort:
      - property: created_dt
        direction: ASC
      - property: file.ctime
        direction: DESC
    cardSize: 240
    imageAspectRatio: 0.85
    rowHeight: medium
    columnSize:
      file.name: 279
      note.created_dt: 176
  - type: table
    name: mature
    filters:
      or:
        - thought_status.contains("archive")
        - thought_status.contains("mature")
    order:
      - file.name
      - created_dt
      - file.mtime
    sort:
      - property: file.ctime
        direction: DESC
    cardSize: 240
    imageAspectRatio: 0.85
    rowHeight: medium
    columnSize:
      file.name: 326
      note.created_dt: 169
  - type: table
    name: freezed
    filters:
      and:
        - thought_status == "freezed"
    order:
      - file.name
      - created_dt
      - file.mtime
    sort:
      - property: file.ctime
        direction: DESC
    cardSize: 240
    imageAspectRatio: 0.85
    rowHeight: medium
    columnSize:
      file.name: 147
      note.created_dt: 187
